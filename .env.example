# ==== App ====
APP_NAME=IntelliVue
DEBUG=true

# ==== Server ====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ==== Database (MySQL) ====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=intellivue

# ==== Auth ====
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ==== AI Providers (fill the ones you use) ====
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-pro

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4

# Default provider used when a task has no override
# Options: gemini | openai | claude | mock
DEFAULT_AI_PROVIDER=gemini

# Per-task provider overrides (optional, leave empty to use default)
RESUME_PROVIDER=
QUESTION_PROVIDER=
EVALUATION_PROVIDER=
BEHAVIOR_PROVIDER=
FEEDBACK_PROVIDER=
REPORT_PROVIDER=

# ==== Redis ====
REDIS_HOST=localhost
REDIS_PORT=6379

# ==== CORS ====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
